# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for authenticating users
JWT_SECRET="super-secret-jwt-key"

# Office Location for Attendance Validation
OFFICE_LATITUDE="30.115610"
OFFICE_LONGITUDE="31.340285"
MAX_DISTANCE_METERS="50"

# MSSQL Database Configuration (For Local IIS Hosting or Static IP)
# Set USE_MSSQL=true to switch to MSSQL mode instead of local JSON file
USE_MSSQL="false"
DB_USER="sa"
DB_PASSWORD="your_password"
DB_NAME="GeoAttendanceDB"
DB_SERVER="localhost" # Database IP address or hostname
DB_PORT="1433"        # Database Port (default is 1433)
